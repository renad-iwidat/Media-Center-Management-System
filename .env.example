# ===== Database Configuration =====
DATABASE_URL=postgresql://username:password@host:port/database

# ===== Server Configuration =====
PORT=7845
NODE_ENV=production

# ===== Authentication Configuration =====
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# ===== Docker Ports (اختياري - افتراضياً 7845 و 7846) =====
BACKEND_PORT=7845
FRONTEND_PORT=7846

# ===== NewsDesk API Configuration (سحب الأخبار) =====
NEWSDESK_API_URL=https://newsdesk-api.liminal.ps

# ===== AI Model Configuration (OpenAI-compatible local model) =====
# AI_MODEL: الـ base URL للموديل المحلي (vLLM/OpenAI-compatible)
AI_MODEL=http://your-ai-model-base-url:8080
# AI_MODEL_NAME: اسم الموديل المُستخدم عبر /v1/chat/completions
AI_MODEL_NAME=Qwen/Qwen3-14B-AWQ
# AI_MODEL_API_KEY: مفتاح الـ API (الموديل المحلي لا يحتاجه فعلياً)
AI_MODEL_API_KEY=not-needed
# AI_MODEL_TIMEOUT: مهلة الطلب بالميلي ثانية
AI_MODEL_TIMEOUT=120000

# ===== OpenAI Configuration (for TTS/STT services) =====
OPENAI_API_KEY=sk-your-openai-api-key-here

