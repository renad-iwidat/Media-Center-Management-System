{
  "name": "media-center-management-system",
  "version": "1.0.0",
  "description": "Media Center Management System - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "migrate": "ts-node scripts/run-migrations.ts",
    "check-migrations": "ts-node scripts/check-migrations.ts",
    "validate-migrations": "ts-node scripts/validate-migrations.ts",
    "cleanup:test": "ts-node src/utils/cleanup-test-data.ts",
    "rss:fetch": "ts-node src/utils/rss-runner.ts",
    "rss:insert": "ts-node src/utils/insert-rss-sources.ts",
    "rss:list": "ts-node src/utils/insert-rss-sources.ts list",
    "rss:delete": "ts-node src/utils/insert-rss-sources.ts delete",
    "classify": "ts-node src/utils/classify-articles.ts",
    "fetch:save": "ts-node src/utils/fetch-and-save.ts",
    "db:test": "ts-node src/utils/test-db-connection.ts",
    "scheduler": "ts-node src/utils/start-scheduler.ts",
    "add-reporters-perm": "ts-node scripts/add-reporters-permission.ts",
    "check:attachments": "ts-node scripts/check-task-attachments.ts",
    "migrate:attachments": "ts-node scripts/migrate-task-attachments.ts",
    "check:content-attachments": "ts-node scripts/check-content-attachments.ts",
    "frontend:build": "cd MCMS-FRONT && npm install && npm run build",
    "frontend:serve": "cd MCMS-FRONT && npm run serve"
  },
  "keywords": [
    "media",
    "management",
    "backend",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/multer": "^2.1.0",
    "@types/socket.io": "^3.0.1",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.0.0",
    "multer": "^2.1.1",
    "pg": "^8.11.3",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.39",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "minimatch": "^10.2.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
