# Streaming Audio Extraction Configuration
# ملف إعدادات استخراج الصوت المتدفق

# FFmpeg Process Management
# إدارة عمليات FFmpeg
MAX_FFMPEG_PROCESSES=3
FFMPEG_TIMEOUT_MS=300000
MAX_AUDIO_SIZE_MB=100
MAX_VIDEO_DOWNLOAD_SIZE_MB=1024  # 1GB limit for video downloads

# Security Settings  
# إعدادات الأمان
ALLOWED_DOMAINS=s3.amazonaws.com,s3.eu-north-1.amazonaws.com,media-center-management-system.s3.eu-north-1.amazonaws.com
ENABLE_DOMAIN_WHITELIST=true
MAX_URL_LENGTH=2048

# Rate Limiting
# تحديد معدل الطلبات
EXTRACTION_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
EXTRACTION_RATE_LIMIT_MAX=10
STREAMING_RATE_LIMIT_WINDOW_MS=300000   # 5 minutes  
STREAMING_RATE_LIMIT_MAX=3

# Performance Settings
# إعدادات الأداء
MAX_CONCURRENT_CHUNKS=3
DEFAULT_AUDIO_BITRATE=128k
MAX_CHUNK_DURATION_SECONDS=300

# Job Management
# إدارة المهام
JOB_CLEANUP_INTERVAL_MS=3600000  # 1 hour
JOB_MAX_AGE_MS=86400000          # 24 hours

# Logging
# السجلات
LOG_LEVEL=info
ENABLE_STRUCTURED_LOGGING=true
LOG_FFMPEG_COMMANDS=false

# Performance Monitoring
# مراقبة الأداء
ENABLE_METRICS=true
METRICS_INTERVAL_MS=60000  # 1 minute